<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_overlay"
    android:layout_width="160dp"
    android:layout_height="220dp"
    android:background="@android:color/transparent">

    <!-- 1. Balon Chat / Emote Popup (Melayang di atas kepala karakter) -->
    <LinearLayout
        android:id="@+id/layout_bubble_chat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bg_bubble_chat"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_bubble_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="130dp"
            android:text="Pasanganmu memanggil! 💖"
            android:textColor="#333333"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. Filament 3D SurfaceView Container -->
    <SurfaceView
        android:id="@+id/surface_filament"
        android:layout_width="140dp"
        android:layout_height="170dp"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@android:color/transparent" />

    <!-- 3. Battery Low Badge Indicator (Muncul jika baterai pasangan < 15%) -->
    <TextView
        android:id="@+id/tv_battery_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="4dp"
        android:background="#D9FF4757"
        android:padding="3dp"
        android:text="🪫 12%"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:visibility="gone" />

</FrameLayout>
